<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.ups</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="delivery.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_delivery_carrier_id']" position="after">
                <field name="bill_my_account_ups" invisible="1"/>
                <field name="property_ups_carrier_account" invisible="not bill_my_account_ups"/>
            </xpath>
        </field>
    </record>
</odoo>
