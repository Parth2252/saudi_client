<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_with_carrier" model="ir.ui.view">
        <field name="name">delivery.sale.order.form.view.with_carrier</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="delivery.view_order_form_with_carrier"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shipping_weight']" position="after">
                <field name="ups_bill_my_account" invisible="1"/>
                <field name="partner_ups_carrier_account" invisible="not ups_bill_my_account" required="ups_bill_my_account"/>
            </xpath>
        </field>
    </record>
</odoo>
