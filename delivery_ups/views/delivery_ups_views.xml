<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.ups</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="before">
                <page string="UPS Configuration" name="ups_configuration" invisible="delivery_type != 'ups'">
                    <group>
                        <group>
                            <field name="ups_shipper_number" required="delivery_type == 'ups'"/>
                            <field name="ups_client_id" required="delivery_type == 'ups'"/>
                            <field name="ups_client_secret" required="delivery_type == 'ups'"/>
                            <field name="ups_default_service_type" required="delivery_type == 'ups'"/>
                        </group>
                        <group>
                            <field name="ups_default_packaging_id" required="delivery_type == 'ups'" domain="[('package_carrier_type', '=', 'ups')]"/>
                            <field name="ups_package_weight_unit" required="delivery_type == 'ups'"/>
                            <field name="ups_package_dimension_unit" required="delivery_type == 'ups'"/>
                            <field name="ups_label_file_type" required="delivery_type == 'ups'"/>
                        </group>
                        <group string="Options">
                            <field name="ups_bill_my_account" invisible="delivery_type != 'ups'"/>
                            <field name="ups_saturday_delivery" invisible="ups_default_service_type in ['03','11','13','59','12','65','08']"/>
                            <field name="ups_cod" invisible="ups_default_service_type == '96'"/>
                            <field name="ups_cod_funds_code" invisible="not ups_cod"/>
                            <field name="ups_duty_payment" required="delivery_type == 'ups'"/>
                            <field name="can_generate_return" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
