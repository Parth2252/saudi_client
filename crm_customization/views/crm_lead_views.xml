<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quick_create_opportunity_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_deadline" placeholder="Expected Closing"/>
            </xpath>
        </field>
    </record>

    <!-- Dashboard for CRM Tree View -->
    <record id="crm_lead_tree_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="js_class">crm_dashboard_list</attribute>
            </list>
            <xpath expr="//field[@name='name']" position="after">
                <field name="date_deadline" widget="date" class="fw-bold" invisible="not show_expected_closing"/>
                <field name="expected_closing_status" class="fw-bold text-primary" invisible="not show_expected_closing"/>
                <field name="show_expected_closing" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="crm_case_kanban_view_leads_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lead.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">crm_dashboard_kanban</attribute>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='priority']" position="replace">
                <field name="show_expected_closing" invisible="1"/>
                <div invisible="not show_expected_closing" class="d-flex flex-column mt-2 py-1">
                    <div class="fw-bold text-dark" style="font-size: 15px;">
                        <field name="date_deadline"/>
                    </div>
                    <div class="fw-bold text-primary mt-1" style="font-size: 14px;">
                        (<field name="expected_closing_status"/>)
                    </div>
                </div>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='activity_ids']" position="replace"/>
        </field>
    </record>

    <record id="view_crm_case_leads_filter_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="open_rfq" string="Open RFQ" domain="[('stage_id.name', 'ilike', 'New RFQ')]"/>
                <filter name="submitted_offer" string="Submitted Offer" domain="[('stage_id.name', 'ilike', 'Offer Submitted')]"/>
                <filter name="order_confirmed" string="Order Confirmed" domain="['|', ('stage_id.name', 'ilike', '%Won%'), ('stage_id.name', 'ilike', '%Sale Order Created%')]"/>
                <filter name="delayed_rfq" string="Delayed RFQ" domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('stage_id.name', 'ilike', 'New RFQ'), ('probability', '&lt;', 100)]"/>
                <filter name="today_closing_rfq" string="Today Closing RFQ" domain="[('is_today_closing', '=', True), ('stage_id.name', 'ilike', 'New RFQ'), ('probability', '&lt;', 100)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_inherit" model="ir.ui.view">
        <field name="name">crm.opportunity.search.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="open_rfq" string="Open RFQ" domain="[('stage_id.name', 'ilike', 'New RFQ')]"/>
                <filter name="submitted_offer" string="Submitted Offer" domain="[('stage_id.name', 'ilike', 'Offer Submitted')]"/>
                <filter name="order_confirmed" string="Order Confirmed" domain="['|', ('stage_id.name', 'ilike', '%Won%'), ('stage_id.name', 'ilike', '%Sale Order Created%')]"/>
                <filter name="delayed_rfq" string="Delayed RFQ" domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('stage_id.name', 'ilike', 'New RFQ'), ('probability', '&lt;', 100)]"/>
                <filter name="today_closing_rfq" string="Today Closing RFQ" domain="[('is_today_closing', '=', True), ('stage_id.name', 'ilike', 'New RFQ'), ('probability', '&lt;', 100)]"/>
            </xpath>
        </field>
    </record>
</odoo>
