<odoo>
    <record id="view_product_template_form_inherit_offer_main" model="ir.ui.view">
        <field name="name">product.template.form.offer.main</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Offer Product Tab -->
                <page string="Offer Products">
                    <field name="offer_product_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="sale_order_id" />
                        </list>
                    </field>
                </page>

                <!-- Main Product Tab -->
                <page string="Main Products">
                    <field name="main_product_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="sale_order_id" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
