<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="purchase.PurchaseDashboard" t-inherit-mode="extension" >
        <xpath expr="//div[1]" position='replace'>
            <div class="o_purchase_dashboard container-fluid py-4 border-bottom bg-view">
                <div class="d-flex justify-content-evenly gap-2 flex-nowrap px-0">

                    <!-- Standard Purchase Block -->
                    <div class="flex-shrink-0">
                        <div class="text-center fw-bold mb-2" style="color: #272AF5; font-size: 0.95rem;">
                            Standard Purchase
                        </div>
                        <div class="d-flex gap-1 justify-content-center">
                            <div t-if="!purchaseData.is_po_view" class="p-0 border-0" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="standard_purchase_to_issues" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #247DC4 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_to_issues']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">To Issue PO</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Ordered Purchase Orders" filter_name="standard_purchase_ordered" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #1FAC5E !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_ordered']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Ordered (Purchase Order)</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="standard_purchase_pending_bill" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #BF033C !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_pending_bill']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Pending Vendor Bill</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Not Paid Bills" filter_name="standard_purchase_bill_not_paid" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #117888 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_bill_not_paid']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Bill Not Paid</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="standard_purchase_bill_paid_not_received" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #F48712 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_bill_paid_not_received']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Bill Paid / Material Not Received</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="standard_purchase_receipt_delay" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #8F000B !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['standard_purchase_receipt_delay']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Material Delay</div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Local purchase block -->
                    <div class="flex-shrink-0">
                        <div class="text-center fw-bold mb-2" style="color: #06BA3D; font-size: 0.95rem;">
                            Local Purchase
                        </div>
                        <div class="d-flex gap-1 justify-content-center">
                            <div t-if="!purchaseData.is_po_view" class="p-0 border-0" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="local_purchase_to_issues" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #247DC4 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_to_issues']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">To Issue PO</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Ordered Purchase Orders" filter_name="local_purchase_ordered" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #1FAC5E !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_ordered']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Ordered (Purchase Order)</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="local_purchase_pending_bill" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #BF033C !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_pending_bill']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Pending Vendor Bill</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Not Paid Bills" filter_name="local_purchase_bill_not_paid" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #117888 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_bill_not_paid']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Bill Not Paid</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="local_purchase_bill_paid_not_received" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #F48712 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_bill_paid_not_received']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Bill Paid / Material Not Received</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="local_purchase_receipt_delay" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #8F000B !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['local_purchase_receipt_delay']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Material Delay</div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Online Purchase Block -->
                    <div class="flex-shrink-0">
                        <div class="text-center fw-bold mb-2" style="color: #EB6D05; font-size: 0.95rem;">
                            Online Purchase
                        </div>
                        <div class="d-flex gap-1 justify-content-center">
                            <div t-if="!purchaseData.is_po_view" class="p-0 border-0" t-on-click="setSearchContext" title="To Order" filter_name="online_purchase_to_order" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #247DC4 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_to_order']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">To Order</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Ordered (Purchase Order)" filter_name="online_purchase_ordered" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #1FAC5E !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_ordered']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Ordered (Purchase Order)</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Ordered Acknowledged" filter_name="online_purchase_acknowledged" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #F48712 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_acknowledged']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Ordered Acknowledged</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Order Shipped" filter_name="online_purchase_shipped" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #117888 !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_shipped']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Order Shipped</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Delayed" filter_name="online_purchase_delayed" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #8F000B !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_delayed']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Delayed</div>
                                </a>
                            </div>
                            <div class="p-0 border-0" t-on-click="setSearchContext" title="Received" filter_name="online_purchase_received" style="width: 92px;">
                                <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-4 d-flex flex-column align-items-center justify-content-center p-1 shadow-sm" style="background-color: #40094D !important; min-height: 85px; transition: transform 0.2s;">
                                    <div class="fs-3 fw-bold" t-out="purchaseData['online_purchase_received']"/>
                                    <div class="text-center" style="font-size: 0.7rem; line-height: 1.1;">Received</div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
