<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="purchase.PurchaseDashboard" t-inherit-mode="extension" >
        <xpath expr="//div[1]" position='replace'>
            <div class="o_purchase_dashboard container-fluid py-4 border-bottom bg-view">
                <style>
                    .dash-container {
                        display: flex;
                        justify-content: center;
                        gap: 40px;
                        flex-wrap: wrap;
                    }
                    .dash-block {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                    }
                    .dash-block-title {
                        font-weight: 700;
                        margin-bottom: 12px;
                        font-size: 0.95rem;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                    }
                    .dash-box-container {
                        display: flex;
                        gap: 8px;
                        justify-content: center;
                    }
                    .dash-box {
                        display: flex;
                        flex-direction: column;
                        width: 100px;
                        cursor: pointer;
                        transition: transform 0.2s, opacity 0.2s;
                        border-radius: 12px;
                        overflow: hidden;
                        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                        border: none;
                    }
                    .dash-box:hover {
                        transform: translateY(-2px);
                        opacity: 0.95;
                    }
                    .dash-item {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 8px 4px;
                        color: white;
                        text-align: center;
                        border-bottom: 0.5px solid rgba(255,255,255,0.15);
                    }
                    .dash-item:last-child {
                        border-bottom: none;
                    }
                    .dash-title {
                        height: 48px;
                        font-size: 0.65rem;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 0.3px;
                        line-height: 1.1;
                    }
                    .dash-count {
                        height: 40px;
                        font-size: 1.35rem;
                        font-weight: 800;
                    }
                </style>
                <div class="dash-container">
                    <!-- Standard Purchase Block -->
                    <div class="dash-block">
                        <div class="dash-block-title" style="color: #272AF5;">
                            Standard Purchase
                        </div>
                        <div class="dash-box-container">
                            <div t-if="!purchaseData.is_po_view" class="dash-box" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="standard_purchase_to_issues" style="background-color: #247DC4 !important;">
                                <div class="dash-item dash-title">To Issue PO</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_to_issues']"/>
                            </div>

                            <div class="dash-box" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="standard_purchase_pending_bill" style="background-color: #BF033C !important;">
                                <div class="dash-item dash-title">Pending Vendor Bill</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_pending_bill']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="All Not Paid Bills" filter_name="standard_purchase_bill_not_paid" style="background-color: #117888 !important;">
                                <div class="dash-item dash-title">Bill Not Paid</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_bill_not_paid']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Partially Paid" filter_name="standard_purchase_partially_paid" style="background-color: #CA6F1E !important;">
                                <div class="dash-item dash-title">Partially Paid</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_partially_paid']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Bill Paid / Material Not Received" filter_name="standard_purchase_bill_paid_not_received" style="background-color: #F48712 !important;">
                                <div class="dash-item dash-title">Bill Paid / Not Rcvd</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_bill_paid_not_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Partially Received" filter_name="standard_purchase_partial_received" style="background-color: #4B0082 !important;">
                                <div class="dash-item dash-title">Partially Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_partial_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Received" filter_name="standard_purchase_received" style="background-color: #40094D !important;">
                                <div class="dash-item dash-title">Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Material Delay" filter_name="standard_purchase_receipt_delay" style="background-color: #8F000B !important;">
                                <div class="dash-item dash-title">Material Delay</div>
                                <div class="dash-item dash-count" t-out="purchaseData['standard_purchase_receipt_delay']"/>
                            </div>
                        </div>
                    </div>

                    <!-- Local purchase block -->
                    <div class="dash-block">
                        <div class="dash-block-title" style="color: #06BA3D;">
                            Local Purchase
                        </div>
                        <div class="dash-box-container">
                            <div t-if="!purchaseData.is_po_view" class="dash-box" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="local_purchase_to_issues" style="background-color: #247DC4 !important;">
                                <div class="dash-item dash-title">To Issue PO</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_to_issues']"/>
                            </div>

                            <div class="dash-box" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="local_purchase_pending_bill" style="background-color: #BF033C !important;">
                                <div class="dash-item dash-title">Pending Vendor Bill</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_pending_bill']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="All Not Paid Bills" filter_name="local_purchase_bill_not_paid" style="background-color: #117888 !important;">
                                <div class="dash-item dash-title">Bill Not Paid</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_bill_not_paid']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Partially Paid" filter_name="local_purchase_partially_paid" style="background-color: #CA6F1E !important;">
                                <div class="dash-item dash-title">Partially Paid</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_partially_paid']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Bill Paid / Material Not Received" filter_name="local_purchase_bill_paid_not_received" style="background-color: #F48712 !important;">
                                <div class="dash-item dash-title">Bill Paid / Not Rcvd</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_bill_paid_not_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Partially Received" filter_name="local_purchase_partial_received" style="background-color: #4B0082 !important;">
                                <div class="dash-item dash-title">Partially Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_partial_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Received" filter_name="local_purchase_received" style="background-color: #40094D !important;">
                                <div class="dash-item dash-title">Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Material Delay" filter_name="local_purchase_receipt_delay" style="background-color: #8F000B !important;">
                                <div class="dash-item dash-title">Material Delay</div>
                                <div class="dash-item dash-count" t-out="purchaseData['local_purchase_receipt_delay']"/>
                            </div>
                        </div>
                    </div>

                    <!-- Online Purchase Block -->
                    <div class="dash-block">
                        <div class="dash-block-title" style="color: #EB6D05;">
                            Online Purchase
                        </div>
                        <div class="dash-box-container">
                            <div t-if="!purchaseData.is_po_view" class="dash-box" t-on-click="setSearchContext" title="To Order" filter_name="online_purchase_to_order" style="background-color: #247DC4 !important;">
                                <div class="dash-item dash-title">To Order</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_to_order']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Ordered (Purchase Order)" filter_name="online_purchase_ordered" style="background-color: #1FAC5E !important;">
                                <div class="dash-item dash-title">Ordered (PO)</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_ordered']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Ordered Acknowledged" filter_name="online_purchase_acknowledged" style="background-color: #F48712 !important;">
                                <div class="dash-item dash-title">Ordered Ack.</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_acknowledged']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Order Shipped" filter_name="online_purchase_shipped" style="background-color: #117888 !important;">
                                <div class="dash-item dash-title">Order Shipped</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_shipped']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Delayed" filter_name="online_purchase_delayed" style="background-color: #8F000B !important;">
                                <div class="dash-item dash-title">Delayed</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_delayed']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Partially Received" filter_name="online_purchase_partial_received" style="background-color: #4B0082 !important;">
                                <div class="dash-item dash-title">Partially Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_partial_received']"/>
                            </div>
                            <div class="dash-box" t-on-click="setSearchContext" title="Received" filter_name="online_purchase_received" style="background-color: #40094D !important;">
                                <div class="dash-item dash-title">Received</div>
                                <div class="dash-item dash-count" t-out="purchaseData['online_purchase_received']"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
