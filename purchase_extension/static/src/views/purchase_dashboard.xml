<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="purchase.PurchaseDashboard" t-inherit-mode="extension" >
        <xpath expr="//div[1]" position='replace'>
            <div class="o_purchase_dashboard container-fluid py-4 border-bottom bg-view">
                <div class="row justify-content-between gap-3 gap-lg-0">

                    <!-- Standard Purchase Block -->
                    <div class="col-12 col-lg-5 col-xl-5 col-xxl-4 flex-grow-1 flex-lg-grow-0 flex-shrink-0">
                        <div class="grid gap-4">
                            <div class="g-col-3 g-col-sm-2 d-flex align-items-center py-2 justify-content-end text-end justify-content-lg-start text-lg-start text-break" style="margin-left : 25px">
                                Standard Purchase
                            </div>
                            <div class="g-col-9 g-col-sm-10 grid gap-1">
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="standard_purchase_to_issues">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['standard_purchase_to_issues']"/>Standard Purchase To Issue
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="standard_purchase_pending_bill">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['standard_purchase_pending_bill']"/>Standard Purchase – Pending Vendor Bill
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="standard_purchase_bill_paid_not_received">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['standard_purchase_bill_paid_not_received']"/>Standard Purchase – Bill Paid but Not Received
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="standard_purchase_receipt_delay">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['standard_purchase_receipt_delay']"/>Standard Purchase – Receipt Delayed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Local purchase block -->
                    <div class="col-12 col-lg-5 col-xl-5 col-xxl-4 flex-grow-1 flex-lg-grow-0 flex-shrink-0">
                        <div class="grid gap-4">
                            <div class="g-col-3 g-col-sm-2 d-flex align-items-center py-2 justify-content-end text-end justify-content-lg-start text-lg-start text-break" style="margin-left : 25px">
                                Local Purchase
                            </div>
                            <div class="g-col-9 g-col-sm-10 grid gap-1">
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="local_purchase_to_issues">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['local_purchase_to_issues']"/>Local Purchase To Issue
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="local_purchase_pending_bill">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['local_purchase_pending_bill']"/>Local Purchase – Pending Vendor Bill
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="local_purchase_bill_paid_not_received">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['local_purchase_bill_paid_not_received']"/>Local Purchase – Bill Paid but Not Received
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="local_purchase_receipt_delay">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['local_purchase_receipt_delay']"/>Local Purchase – Receipt Delayed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Online Purchase Block -->
                    <div class="col-12 col-lg-5 col-xl-5 col-xxl-4 flex-grow-1 flex-lg-grow-0 flex-shrink-0">
                        <div class="grid gap-4">
                            <div class="g-col-3 g-col-sm-2 d-flex align-items-center py-2 justify-content-end text-end justify-content-lg-start text-lg-start text-break" style="margin-left : 25px">
                                Online Purchase
                            </div>
                            <div class="g-col-9 g-col-sm-10 grid gap-1">
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Draft RFQs" filter_name="online_purchase_to_issues">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['online_purchase_to_issues']"/>Online Purchase To Issue
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Waiting RFQs" filter_name="online_purchase_pending_bill">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['online_purchase_pending_bill']"/>Online Purchase – Pending Vendor Bill
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="online_purchase_bill_paid_not_received">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['online_purchase_bill_paid_not_received']"/>Online Purchase – Bill Paid but Not Received
                                    </a>
                                </div>
                                <div class="g-col-3 p-0" t-on-click="setSearchContext" title="All Late RFQs" filter_name="online_purchase_receipt_delay">
                                    <a href="#" class="btn btn-primary w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                                        <div class="fs-2" t-out="purchaseData['online_purchase_receipt_delay']"/>Online Purchase – Receipt Delayed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
