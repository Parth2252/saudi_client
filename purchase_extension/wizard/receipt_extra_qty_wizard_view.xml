<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_receipt_extra_qty_wizard_form" model="ir.ui.view">
        <field name="name">receipt.extra.qty.wizard.form</field>
        <field name="model">receipt.extra.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Extra Quantity Reason">
                <group>
                    <div class="alert alert-warning" role="alert">
                        You are receiving more quantity than what was ordered in the Purchase Order. Please provide a reason below.
                    </div>
                    <field name="picking_id" invisible="1"/>
                    <field name="reason" placeholder="Enter reason for receiving extra quantity..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Validate" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
