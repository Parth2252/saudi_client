<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">order.confirmation.wizard.form</field>
        <field name="model">order.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Order Confirmation Number">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="confirmation_number"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_order_confirmation_wizard" model="ir.actions.act_window">
        <field name="name">Order Confirmation Number</field>
        <field name="res_model">order.confirmation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
