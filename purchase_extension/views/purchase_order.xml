<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order</attribute>
                <attribute name="decoration-danger">is_overdue</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_partner_id"/>
                <field name="receipt_delay" optional='hide'/>
                <field name="purchase_source" 
                       optional="show" 
                       decoration-success="purchase_source == 'local'"
                       decoration-info="purchase_source == 'standard'"
                       decoration-warning="purchase_source == 'online'"
                       widget="badge"
                       />
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Delivery Date</attribute>
            </xpath>

        </field>
    </record>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_ref"/>
                <field name="purchase_source" />
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Purchase Source" name="purchase_source" domain="[]" context="{'group_by':'purchase_source'}"/>
            </xpath>

            <xpath expr="//filter[@name='starred']" position="after">
                <!-- Standard Filter -->
                <separator/>
                <filter name="standard_purchase_to_issues" string="Standard Purchase To Issue" domain="[('state', 'in', ('draft', 'sent')), ('po_reference', '!=', False), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_pending_bill"
                string="Standard Purchase – Pending Vendor Bill"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'standard'),
                    '|',
                        ('invoice_ids', '=', False),
                        ('invoice_ids.state', '=', 'draft')
                ]"/>
                <filter name="standard_purchase_bill_paid_not_received"
                string="Standard Purchase – Bill Paid but Not Received"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'standard'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    '|',
                    ('picking_ids', '=', False),
                    ('picking_ids.state', 'in', ('waiting','assigned','confirmed'))
                ]"/>
                <filter name="standard_purchase_receipt_delay"
                string="Standard Purchase – Receipt Delayed"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'standard'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    ('picking_ids.state', 'in', ('done', 'delivered')),
                    ('receipt_delay', '>', 0)
                ]"/>


                <!-- Local Purchase -->
                <separator/>
                <filter name="local_purchase_to_issues" string="Local Purchase To Issue" domain="[('state', 'in', ('draft', 'sent')), ('po_reference', '!=', False), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_pending_bill"
                string="Local Purchase – Pending Vendor Bill"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'local'),
                    '|',
                        ('invoice_ids', '=', False),
                        ('invoice_ids.state', '=', 'draft')
                ]"/>
                <filter name="local_purchase_bill_paid_not_received"
                string="Local Purchase – Bill Paid but Not Received"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'local'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    '|',
                    ('picking_ids', '=', False),
                    ('picking_ids.state', 'in', ('waiting','assigned','confirmed'))
                ]"/>
                <filter name="local_purchase_receipt_delay"
                string="Local Purchase – Receipt Delayed"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'local'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    ('picking_ids.state', 'in', ('done', 'delivered')),
                    ('receipt_delay', '>', 0)
                ]"/>


                <!-- Online Purchase -->
                <separator/>
                <filter name="online_purchase_to_issues" string="Online Purchase To Issue" domain="[('state', 'in', ('draft', 'sent')), ('po_reference', '!=', False), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_pending_bill"
                string="Online Purchase – Pending Vendor Bill"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'online'),
                    '|',
                        ('invoice_ids', '=', False),
                        ('invoice_ids.state', '=', 'draft')
                ]"/>
                <filter name="online_purchase_bill_paid_not_received"
                string="Online Purchase – Bill Paid but Not Received"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'online'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    '|',
                    ('picking_ids', '=', False),
                    ('picking_ids.state', 'in', ('waiting','assigned','confirmed'))
                ]"/>
                <filter name="online_purchase_receipt_delay"
                string="Online Purchase – Receipt Delayed"
                domain="[
                    ('state', 'in', ('purchase','done')),
                    ('po_reference', '!=', False),
                    ('purchase_source', '=', 'online'),
                    ('invoice_ids.payment_state', '=', 'paid'),
                    ('picking_ids.state', 'in', ('done', 'delivered')),
                    ('receipt_delay', '>', 0)
                ]"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="ts_code"/>
                <field name="product_url" widget="url" optional="show"/>
                <field name="product_code"/>
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="sr_no_po"/>
            </xpath>

            <!--            NEW-->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <!-- Added fields. -->
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="print_vendor_item_code_and_name" invisible="state not in '(purchase, done)'" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contact_id"
                       domain="['&amp;', ('parent_id', '=', partner_id), ('is_company', '!=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a customer contact..." readonly="state in ['cancel', 'sale']"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="po_expire_date" />
                <field name="sale_partner_id" />
            </xpath>
            <!--            NEW-->

            <xpath expr="//field[@name='project_id']" position="after">
                <field name="purchase_source" />
            </xpath>

            <xpath expr="//page/field[@name='order_line']/list/field[@name='date_planned']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>

        </field>
    </record>

    <record id="action_open_purchase_source_wizard" model="ir.actions.server">
        <field name="name">Update Purchase Source</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        action = {
            "type": "ir.actions.act_window",
            "name": "Update Purchase Source",
            "res_model": "purchase.source.wizard",
            "view_mode": "form",
            "target": "new",
        }
        </field>
    </record>


</odoo>
