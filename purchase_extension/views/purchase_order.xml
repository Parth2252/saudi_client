    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_confirmation_number"
                        string="Add Confirmation Number"
                        type="object"
                        class="btn-primary"
                        invisible="purchase_source != 'online' or order_confirmation_number or state not in ('purchase', 'done')"/>
                <button name="action_add_order_status"
                        string="Update Order Status"
                        type="object"
                        class="btn-primary"
                        invisible="purchase_source != 'online' or order_status or state not in ('purchase', 'done')"/>
                <button name="action_open_new_rfq_wizard"
                        string="Create RFQ"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"/>
                <button name="%(purchase.action_report_purchase_order)d"
                        string="Print Purchase Order"
                        type="action"
                        class="btn_teal"/>
                <button name="%(purchase.report_purchase_quotation)d"
                        string="Print RFQ"
                        type="action"
                        class="btn_plum"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0 text-center" role="alert" invisible="purchase_source != 'online' or order_confirmation_number or state not in ('purchase', 'done')">
                    <strong>Missing Info!</strong> Please add the Order Confirmation Number for this Online Purchase.
                </div>
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="ts_code"/>
                <field name="product_url" widget="url" optional="show"/>
                <field name="product_code"/>
                <field name="customer_pdd" />
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="select_for_new_rfq" nolabel="1" invisible="display_type"/>
                <field name="sr_no_po" invisible="0"/>
            </xpath>

            <!--            NEW-->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <!-- Added fields. -->
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="print_vendor_item_code_and_name" invisible="state not in '(purchase, done)'" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contact_id"
                       domain="['&amp;', ('parent_id', '=', partner_id), ('is_company', '!=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a vendor contact..." readonly="state in ['cancel', 'sale']"/>
                <field name="customer_contact_id"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a customer contact..."/>
                <field name="partner_invoice_id"
                       context="{'show_address': 1}"
                       options='{"always_reload": True}'/>
                <field name="partner_shipping_id"
                       context="{'show_address': 1}"
                       options='{"always_reload": True}'/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="po_expire_date" />
                <field name="sale_partner_id" />
            </xpath>
            <!--            NEW-->

            <xpath expr="//field[@name='project_id']" position="after">
                <field name="purchase_source" />
                <field name="order_confirmation_number"
                       class="text-success fw-bold"
                       readonly="0"/>
                <field name="is_confirmation_filled" invisible="1"/>
                <label for="is_confirmation_filled" string=" " invisible="not is_confirmation_filled"/>
                <div class="d-flex" invisible="not is_confirmation_filled">
                     <span class="badge rounded-pill text-bg-success py-2 px-3">
                        <i class="fa fa-check-circle me-1"/> Confirmed
                     </span>
                </div>
                <field name="po_status" />
                <field name="receipt_status"
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-danger="receipt_status == 'pending'"/>
                <field name="order_status"
                       decoration-success="order_status in ('acknowledged', 'shipped')"/>
                <field name="tracking_number" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_name" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_url" widget="url" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="attachment_type_ids" widget="many2many_tags" options="{'color_field': 'color'}" required="1"/>
            </xpath>

            <xpath expr="//page/field[@name='order_line']/list/field[@name='date_planned']" position="attributes">
                <attribute name="required">not display_type</attribute>
            </xpath>


        </field>
    </record>

    <record id="action_open_purchase_source_wizard" model="ir.actions.server">
        <field name="name">Update Purchase Source</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        action = {
            "type": "ir.actions.act_window",
            "name": "Update Purchase Source",
            "res_model": "purchase.source.wizard",
            "view_mode": "form",
            "target": "new",
        }
        </field>
    </record>


    <record id="action_update_po_status" model="ir.actions.server">
        <field name="name">Update PO Status (Recompute)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records._compute_po_status()
        </field>
    </record>

    <record id="action_force_recompute_all_po_status" model="ir.actions.server">
        <field name="name">Update All PO Status (Global)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">
            env['purchase.order'].search([]).with_context(skip_product_url_check=True)._compute_po_status()
        </field>
    </record>

    <record id="purchase_attachment_type_view_tree" model="ir.ui.view">
        <field name="name">purchase.attachment.type.list</field>
        <field name="model">purchase.attachment.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="purchase_attachment_type_action" model="ir.actions.act_window">
        <field name="name">Attachment Types</field>
        <field name="res_model">purchase.attachment.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_attachment_type"
              name="Attachment Types"
              parent="purchase.menu_purchase_config"
              action="purchase_attachment_type_action"
              sequence="100"/>

    <record id="purchase.purchase_form_action" model="ir.actions.act_window">
        <field name="context">{'is_po_view': True}</field>
    </record>

</odoo>
