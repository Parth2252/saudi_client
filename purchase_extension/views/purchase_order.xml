<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order</attribute>
                <attribute name="decoration-danger">is_overdue</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_partner_id"/>
                <field name="receipt_delay" optional='hide'/>
                <field name="purchase_source" 
                       optional="show" 
                       decoration-success="purchase_source == 'local'"
                       decoration-info="purchase_source == 'standard'"
                       decoration-warning="purchase_source == 'online'"
                       widget="badge"
                       />
                <field name="order_confirmation_number"
                       optional="hide"
                       decoration-success="order_confirmation_number != False"
                       widget="badge"/>
                <field name="po_status" optional="show" widget="badge"/>
                <field name="order_status"
                       optional="hide"
                       decoration-success="order_status in ('acknowledged', 'shipped')"/>
                <field name="tracking_number" invisible="order_status != 'shipped'"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Delivery Date</attribute>
            </xpath>

        </field>
    </record>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_ref"/>
                <field name="purchase_source" />
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Purchase Source" name="purchase_source" domain="[]" context="{'group_by':'purchase_source'}"/>
            </xpath>

            <xpath expr="//filter[@name='starred']" position="after">
                <!-- Standard Filter -->
                <separator/>
                <filter name="standard_purchase_to_issues" string="Standard Purchase To Issue" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_ordered" string="Standard Purchase (Ordered)" domain="[('po_status', '=', 'ordered'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_pending_bill"
                string="Standard Purchase – Pending Vendor Bill"
                domain="[('po_status', '=', 'pending_bill'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_bill_not_paid"
                string="Standard Purchase – Bill Not Paid"
                domain="[('po_status', '=', 'bill_not_paid'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_bill_paid_not_received"
                string="Standard Purchase – Bill Paid but Not Received"
                domain="[('po_status', '=', 'paid_not_received'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_receipt_delay"
                string="Standard Purchase – Receipt Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'standard')]"/>


                <!-- Local Purchase -->
                <separator/>
                <filter name="local_purchase_to_issues" string="Local Purchase To Issue" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_ordered" string="Local Purchase (Ordered)" domain="[('po_status', '=', 'ordered'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_pending_bill"
                string="Local Purchase – Pending Vendor Bill"
                domain="[('po_status', '=', 'pending_bill'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_bill_not_paid"
                string="Local Purchase – Bill Not Paid"
                domain="[('po_status', '=', 'bill_not_paid'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_bill_paid_not_received"
                string="Local Purchase – Bill Paid but Not Received"
                domain="[('po_status', '=', 'paid_not_received'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_receipt_delay"
                string="Local Purchase – Receipt Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'local')]"/>


                <!-- Online Purchase -->
                <separator/>
                <filter name="online_purchase_to_order" string="Online Purchase (To Order)" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_ordered" string="Online Purchase (Ordered)" domain="[('po_status', '=', 'ordered'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_acknowledged"
                string="Online Purchase – Acknowledged"
                domain="[('po_status', '=', 'acknowledged'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_shipped"
                string="Online Purchase – Shipped"
                domain="[('po_status', '=', 'shipped'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_delayed"
                string="Online Purchase – Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_received"
                string="Online Purchase – Received"
                domain="[('po_status', '=', 'received'), ('purchase_source', '=', 'online')]"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_confirmation_number"
                        string="Add Confirmation Number"
                        type="object"
                        class="btn-primary"
                        invisible="purchase_source != 'online' or order_confirmation_number or state not in ('purchase', 'done')"/>
                <button name="action_add_order_status"
                        string="Update Order Status"
                        type="object"
                        class="btn-primary"
                        invisible="purchase_source != 'online' or order_status or state not in ('purchase', 'done')"/>
                <button name="action_open_new_rfq_wizard"
                        string="Create RFQ"
                        type="object"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0 text-center" role="alert" invisible="purchase_source != 'online' or order_confirmation_number or state not in ('purchase', 'done')">
                    <strong>Missing Info!</strong> Please add the Order Confirmation Number for this Online Purchase.
                </div>
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="ts_code"/>
                <field name="product_url" widget="url" optional="show"/>
                <field name="product_code"/>
                <field name="customer_pdd" />
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="select_for_new_rfq" nolabel="1" invisible="display_type"/>
                <field name="sr_no_po" invisible="0"/>
            </xpath>

            <!--            NEW-->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <!-- Added fields. -->
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="print_vendor_item_code_and_name" invisible="state not in '(purchase, done)'" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contact_id"
                       domain="['&amp;', ('parent_id', '=', partner_id), ('is_company', '!=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a customer contact..." readonly="state in ['cancel', 'sale']"/>
                <field name="customer_contact_id"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a customer contact..."/>
                <field name="partner_invoice_id"
                       context="{'show_address': 1}"
                       options='{"always_reload": True}'/>
                <field name="partner_shipping_id"
                       context="{'show_address': 1}"
                       options='{"always_reload": True}'/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="po_expire_date" />
                <field name="sale_partner_id" />
            </xpath>
            <!--            NEW-->

            <xpath expr="//field[@name='project_id']" position="after">
                <field name="purchase_source" />
                <field name="order_confirmation_number"
                       class="text-success fw-bold"
                       readonly="0"/>
                <field name="is_confirmation_filled" invisible="1"/>
                <label for="is_confirmation_filled" string=" " invisible="not is_confirmation_filled"/>
                <div class="d-flex" invisible="not is_confirmation_filled">
                     <span class="badge rounded-pill text-bg-success py-2 px-3">
                        <i class="fa fa-check-circle me-1"/> Confirmed
                     </span>
                </div>
                <field name="po_status" />
                <field name="order_status"
                       decoration-success="order_status in ('acknowledged', 'shipped')"/>
                <field name="tracking_number" invisible="order_status != 'shipped'"/>
            </xpath>

            <xpath expr="//page/field[@name='order_line']/list/field[@name='date_planned']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="action_open_purchase_source_wizard" model="ir.actions.server">
        <field name="name">Update Purchase Source</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        action = {
            "type": "ir.actions.act_window",
            "name": "Update Purchase Source",
            "res_model": "purchase.source.wizard",
            "view_mode": "form",
            "target": "new",
        }
        </field>
    </record>


    <record id="action_update_po_status" model="ir.actions.server">
        <field name="name">Update PO Status (Recompute)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            records._compute_po_status()
        </field>
    </record>

    <record id="action_force_recompute_all_po_status" model="ir.actions.server">
        <field name="name">Update All PO Status (Global)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">
            env['purchase.order'].search([('po_reference', '!=', False)]).with_context(skip_product_url_check=True)._compute_po_status()
        </field>
    </record>

</odoo>
