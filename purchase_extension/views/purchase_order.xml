<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.overdue</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order</attribute>
                <attribute name="decoration-danger">is_overdue</attribute>
                <attribute name="js_class">purchase_dashboard_list</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_partner_id"/>
                <field name="receipt_delay" optional='hide'/>
                <field name="purchase_source" 
                       optional="show" 
                       decoration-success="purchase_source == 'local'"
                       decoration-info="purchase_source == 'standard'"
                       decoration-warning="purchase_source == 'online'"
                       widget="badge"
                       />
                <field name="order_confirmation_number"
                       optional="hide"
                       decoration-success="order_confirmation_number != False"
                       widget="badge"/>
                <field name="po_status" optional="show" widget="badge"/>
                <field name="order_status"
                       optional="hide"
                       decoration-success="order_status in ('acknowledged', 'shipped')"/>
                <field name="tracking_number" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_name" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_url" widget="url" class="text_teal" invisible="order_status != 'shipped'"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Delivery Date</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="effective_date" column_invisible="True"/>
                <field name="receipt_status" 
                       optional="show" 
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-danger="receipt_status == 'pending'"/>
            </xpath>


        </field>
    </record>

    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.dashboard</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">purchase_dashboard_list</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_partner_id"/>
                <field name="receipt_delay" optional='hide'/>
                <field name="purchase_source"
                       optional="show"
                       decoration-success="purchase_source == 'local'"
                       decoration-info="purchase_source == 'standard'"
                       decoration-warning="purchase_source == 'online'"
                       widget="badge"
                       />
                <field name="order_confirmation_number"
                       optional="hide"
                       decoration-success="order_confirmation_number != False"
                       widget="badge"/>
                <field name="po_status" optional="show" widget="badge"/>
                <field name="order_status"
                       optional="hide"
                       decoration-success="order_status in ('acknowledged', 'shipped')"/>
                <field name="tracking_number" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_name" class="text_teal" invisible="order_status != 'shipped'"/>
                <field name="logistic_url" widget="url" class="text_teal" invisible="order_status != 'shipped'"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="date_order_display"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Delivery Date</attribute>
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="effective_date" column_invisible="True"/>
                <field name="receipt_status" 
                       optional="show" 
                       widget="badge"
                       decoration-success="receipt_status == 'full'"
                       decoration-warning="receipt_status == 'partial'"
                       decoration-danger="receipt_status == 'pending'"/>
            </xpath>



        </field>
    </record>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_ref"/>
                <field name="purchase_source" />
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Purchase Source" name="purchase_source" domain="[]" context="{'group_by':'purchase_source'}"/>
            </xpath>

            <xpath expr="//filter[@name='starred']" position="after">
                <!-- Standard Filter -->
                <separator/>
                <filter name="standard_purchase_to_approve" string="Standard Purchase (To Approve)" domain="[('state', '=', 'to approve'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_to_issues" string="Standard Purchase To Issue" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_received" string="Standard Purchase (Received)" domain="[('po_status', '=', 'received'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_pending_bill"
                string="Standard Purchase – Pending Vendor Bill"
                domain="[('po_status', '=', 'pending_bill'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_bill_not_paid"
                string="Standard Purchase – Bill Not Paid"
                domain="[('po_status', '=', 'bill_not_paid'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_partially_paid"
                string="Standard Purchase – Partially Paid"
                domain="[('po_status', '=', 'partially_paid'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_bill_paid_not_received"
                string="Standard Purchase – Bill Paid but Not Received"
                domain="[('po_status', '=', 'paid_not_received'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_receipt_delay"
                string="Standard Purchase – Receipt Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'standard')]"/>
                <filter name="standard_purchase_partial_received"
                string="Standard Purchase – Partially Received"
                domain="[('receipt_status', '=', 'partial'), ('purchase_source', '=', 'standard')]"/>


                <!-- Local Purchase -->
                <separator/>
                <filter name="local_purchase_to_approve" string="Local Purchase (To Approve)" domain="[('state', '=', 'to approve'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_to_issues" string="Local Purchase To Issue" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_received" string="Local Purchase (Received)" domain="[('po_status', '=', 'received'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_pending_bill"
                string="Local Purchase – Pending Vendor Bill"
                domain="[('po_status', '=', 'pending_bill'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_bill_not_paid"
                string="Local Purchase – Bill Not Paid"
                domain="[('po_status', '=', 'bill_not_paid'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_partially_paid"
                string="Local Purchase – Partially Paid"
                domain="[('po_status', '=', 'partially_paid'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_bill_paid_not_received"
                string="Local Purchase – Bill Paid but Not Received"
                domain="[('po_status', '=', 'paid_not_received'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_receipt_delay"
                string="Local Purchase – Receipt Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'local')]"/>
                <filter name="local_purchase_partial_received"
                string="Local Purchase – Partially Received"
                domain="[('receipt_status', '=', 'partial'), ('purchase_source', '=', 'local')]"/>


                <!-- Online Purchase -->
                <separator/>
                <filter name="online_purchase_to_approve" string="Online Purchase (To Approve)" domain="[('state', '=', 'to approve'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_to_order" string="Online Purchase (To Order)" domain="[('po_status', '=', 'to_issue'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_ordered" string="Online Purchase (Ordered)" domain="[('po_status', '=', 'ordered'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_acknowledged"
                string="Online Purchase – Acknowledged"
                domain="[('po_status', '=', 'acknowledged'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_shipped"
                string="Online Purchase – Shipped"
                domain="[('po_status', '=', 'shipped'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_delayed"
                string="Online Purchase – Delayed"
                domain="[('po_status', '=', 'material_delay'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_received"
                string="Online Purchase – Received"
                domain="[('po_status', '=', 'received'), ('purchase_source', '=', 'online')]"/>
                <filter name="online_purchase_partial_received"
                string="Online Purchase – Partially Received"
                domain="[('receipt_status', '=', 'partial'), ('purchase_source', '=', 'online')]"/>
            </xpath>
        </field>
    </record>

