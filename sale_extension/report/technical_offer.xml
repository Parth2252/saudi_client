                                    </td>
                                    <td style="text-align: center; padding-top: 5px; padding-right: 10px;">
                                        <span t-esc="0.0"
                                              t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="background: #0066FF; color: #fff; font-weight: bold;">
                                    <td style="padding: 5px; border-bottom-left-radius: 14px;">
                                        الإجمالي<br/>Total
                                    </td>
                                    <td style="text-align: center; padding-top: 5px; padding-right: 10px;">
                                        <span t-esc="0.0"
                                              t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                </t> <!-- End Main Part -->


                <!-- 2. APPENDIX ITEM SECTION (Header + Image/Note) -->
                <t t-if="render_part == 'appendix_item' and target_line_id">
                    <t t-set="appendix_lines" t-value="doc.order_line.filtered(lambda l: l.datasheet_attach)"/>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-if="line.id == target_line_id">

                            <!-- Page for Item Header/Table -->
                            <div style="margin-top: 350px; text-align: center;">
                                <h4 style="color: #0066ff; font-weight: bold; border-bottom: 2px solid #0066ff; padding-bottom: 5px; margin-bottom: 25px; text-align: center;">
                                    Detailed Technical Datasheet - Item #<t t-esc="line.sr_no_so"/>
                                </h4>

                                <table class="table table-bordered mb-4" style="font-size: 10px; width: 100%; border-collapse: collapse; text-align: left;">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">#<br/>SN</th>
                                            <t t-if="show_pr"><th class="text-center" style="background-color: #0066ff; color: white;">PR Number</th></t>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Item Code</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Description</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">TS Code</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Offered Description</th>
                                            <t t-if="show_img"><th class="text-center" style="background-color: #0066ff; color: white;">Photo</th></t>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">UOM</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Qty</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Unit Price</th>
                                            <t t-if="show_discount"><th class="text-center" style="background-color: #0066ff; color: white;">Discount %</th></t>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Amount</th>
                                            <th class="text-center" style="background-color: #0066ff; color: white;">Delivery Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color: #ffffff;">
                                            <td class="text-center align-middle"><t t-esc="line.sr_no_so"/></td>
                                            <t t-if="show_pr"><td class="text-center align-middle"><span t-esc="line.pr_number or ''"/></td></t>
                                            <td class="text-center align-middle"><t t-esc="line.return_item_code()"/></td>
                                            <td class="text-start align-middle">
                                                <t t-if="line.offered_description_id"><span t-esc="line.product_template_id.name or ''"/></t>
                                                <t t-elif="line.show_customer_product_name()"><span t-esc="line.sh_line_customer_product_name"/></t>
                                            </td>
                                            <td class="text-center align-middle"><t t-esc="line.return_ts_code()"/></td>
                                            <td class="text-start align-middle">
                                                <t t-if="line.offered_description_id"><span t-esc="line.offered_description_id.name"/></t>
                                                <t t-elif="line.is_not_available"><span style="color:darkorange; font-weight:bold;">TO BE QUOTED</span></t>
                                                <t t-else=""><span style="color:green; font-weight:bold;">AS SPECIFIED</span></t>
                                            </td>
                                            <t t-if="show_img">
                                                <td class="text-center align-middle">
                                                    <t t-if="line.offered_image">
                                                        <img t-att-src="image_data_uri(line.offered_image)" style="max-width:60px; max-height:60px;"/>
                                                    </t>
                                                </td>
                                            </t>
                                            <td class="text-center align-middle"><span t-field="line.product_uom"/></td>
                                            <td class="text-center align-middle"><span t-field="line.product_uom_qty"/></td>
                                            <td class="text-center align-middle"><span t-esc="0.0" t-options='{"widget":"monetary","display_currency":doc.currency_id}'/></td>
                                            <t t-if="show_discount"><td class="text-center align-middle"><span t-field="line.discount"/></td></t>
                                            <td class="text-center align-middle"><span t-esc="0.0" t-options='{"widget":"monetary","display_currency":doc.currency_id}'/></td>
                                            <td class="text-center align-middle">
                                                <t t-if="line.delivery_time_display"><span t-esc="line.delivery_time_display"/></t>
                                                <t t-else=""><span/></t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Integrated Content Section (Images only) -->
                            <div t-if="line.upload_datasheet_attachment and line.is_attachment_image()"
                                 style="page-break-before: always; clear: both; text-align: center; padding-top: 30px;">
                                 <img t-att-src="image_data_uri(line.upload_datasheet_attachment)"
                                      style="max-width: 100%; max-height: 980px; border: 1px solid #ddd; padding: 5px; border-radius: 4px;"/>
                                 <div style="margin-top: 15px; color: #666; font-size: 14px; font-weight: bold;">
                                     Technical Specification for Item #<t t-esc="line.sr_no_so"/>
                                 </div>
                            </div>
                        </t>
                    </t>
                </t>
            </div>
        </t>

    </template>


    <template id="report_technical_offer">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale_extension.report_technical_offer_document"/>
            </t>
        </t>
    </template>
    <record id="action_report_technical_offer" model="ir.actions.report">
        <field name="name">Technical Offer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_extension.report_technical_offer</field>
        <field name="report_file">sale_extension.report_technical_offer</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_type">report</field>
        <!--        <field name="print_report_name">'Technical Offer - %s' % (object.name)</field>-->
        <field name="print_report_name">'TAMSTAR_%s_UNPRICED TECHNICAL OFFER_%s_%s' % (object.name, object.quote_desc or
            '', object.partner_id.parent_id.name or object.partner_id.name or '')
        </field>
    </record>

</odoo>
