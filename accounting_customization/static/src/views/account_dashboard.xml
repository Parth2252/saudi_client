<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="accounting_customization.AccountDashboardListView" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <AccountDashBoard />
        </xpath>
    </t>

    <t t-name="accounting_customization.AccountDashboard">
        <div class="o_account_dashboard ps-3 pe-3 pt-4 pb-4 bg-view border-bottom">
            <style>
                .dash-container {
                    display: flex;
                    justify-content: center;
                    gap: 12px;
                }
                .dash-box {
                    display: flex;
                    flex-direction: column;
                    width: 140px;
                    cursor: pointer;
                    transition: transform 0.2s, opacity 0.2s;
                    border-radius: 16px;
                    overflow: hidden;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    border: none;
                }
                .dash-box:hover {
                    transform: translateY(-2px);
                    opacity: 0.95;
                }
                .dash-item {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 8px 5px;
                    color: white;
                    text-align: center;
                    border-bottom: 0.5px solid rgba(255,255,255,0.15);
                }
                .dash-item:last-child {
                    border-bottom: none;
                }
                .dash-title {
                    height: 55px;
                    font-size: 0.85rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding-top: 12px;
                }
                .dash-count {
                    height: 45px;
                    font-size: 1.5rem;
                    font-weight: 800;
                }
                .dash-total {
                    height: 45px;
                    font-size: 1rem;
                    font-weight: 500;
                    background-color: rgba(0,0,0,0.1);
                    padding-bottom: 10px;
                }
            </style>
            <div class="dash-container">
                <!-- To Validate -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="to_validate" style="background-color: #247DC4 !important;">
                    <div class="dash-item dash-title">To Validate</div>
                    <div class="dash-item dash-count" t-out="purchaseData['to_validate']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['to_validate']['total'] or 0"/>
                </div>

                <!-- Today Payable -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="today_payable" style="background-color: #1FAC5E !important;">
                    <div class="dash-item dash-title">Today Payable</div>
                    <div class="dash-item dash-count" t-out="purchaseData['today_payable']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['today_payable']['total'] or 0"/>
                </div>

                <!-- Late Payments -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="late_payments" style="background-color: #BF033C !important;">
                    <div class="dash-item dash-title">Late Payments</div>
                    <div class="dash-item dash-count" t-out="purchaseData['late_payments']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['late_payments']['total'] or 0"/>
                </div>

                <!-- Partially Paid Bills -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="partially_paid" style="background-color: #F48712 !important;">
                    <div class="dash-item dash-title">Partially Paid Bills</div>
                    <div class="dash-item dash-count" t-out="purchaseData['partially_paid']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['partially_paid']['total'] or 0"/>
                </div>

                <!-- Fully Paid Bills -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="fully_paid" style="background-color: #117888 !important;">
                    <div class="dash-item dash-title">Fully Paid Bills</div>
                    <div class="dash-item dash-count" t-out="purchaseData['fully_paid']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['fully_paid']['total'] or 0"/>
                </div>

                <!-- Credit Note -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="credit_note" style="background-color: #40094D !important;">
                    <div class="dash-item dash-title">Credit Note</div>
                    <div class="dash-item dash-count" t-out="purchaseData['credit_note']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['credit_note']['total'] or 0"/>
                </div>

                <!-- Utility Bills -->
                <div class="dash-box" t-on-click="setSearchContext" filter_name="utility_bills" style="background-color: #8F000B !important;">
                    <div class="dash-item dash-title">Utility Bills</div>
                    <div class="dash-item dash-count" t-out="purchaseData['utility_bills']['count'] or 0"/>
                    <div class="dash-item dash-total" t-out="purchaseData['utility_bills']['total'] or 0"/>
                </div>
            </div>
        </div>
    </t>
</templates>
