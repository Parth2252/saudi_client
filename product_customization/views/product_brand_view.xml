<odoo>
    <record model="ir.ui.view" id="product_customization_product_brand_form_view">
      <field name="name">product.customization.product.brand.form.view</field>
      <field name="model">product.brand</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                  <group>
                      <field name="name" required="1"/>
                  </group>
                </group>
            </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="product_customization_product_brand_list_view">
      <field name="name">product.customization.product.brand.list.view</field>
      <field name="model">product.brand</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
        </list>
      </field>
    </record>

    <record id="product_customization_product_brand_search_view" model="ir.ui.view">
        <field name="name">product.customization.product.brand.search.view</field>
        <field name="model">product.brand</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <search string="Search Product Brand">
              <field name="name" string="Brand Name" />
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="product_brand_window_action">
      <field name="name">Product Brand</field>
      <field name="res_model">product.brand</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Product Brand" id="menu_product_brand_sale" action="product_brand_window_action" parent="sale.prod_config_main"/>
    <menuitem name="Product Brand" id="menu_product_brand_purchase" action="product_brand_window_action" parent="purchase.menu_product_in_config_purchase"/>

</odoo>
