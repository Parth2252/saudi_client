<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_customization_view_partner_form_inherit_form_view" model="ir.ui.view">
        <field name="name">product.customization.view.partner.form.inherit.form.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Partner Product Details">
                    <field name="partner_product_line_ids" widget="many2one_list">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="partner_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="product_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="brand_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="product_image" widget="image" options="{'size': [64, 64]}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
