<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_customization_view_partner_form_inherit_form_view" model="ir.ui.view">
        <field name="name">product.customization.view.partner.form.inherit.form.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Partner Product Details">
                    <header>
                        <button name="action_recompute_products" type="object" string="Recompute Product Groups" class="oe_highlight"/>
                    </header>
                    <field name="partner_product_line_ids" widget="many2one_list">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="brand_id" required="1"/>
                            <field name="product_image" widget="image" options="{'size': [64, 64]}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_customization_view_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.product.customization</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="product_ids" widget="many2many_tags" optional="hide"/>
                <field name="brand_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_customization_view_res_partner_filter_inherit" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.product.customization</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="product_ids" string="Product" />
                <field name="brand_ids" string="Brand" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_product" string="Product" context="{'group_by': 'product_ids'}" />
                <filter name="group_by_brand" string="Brand" context="{'group_by': 'brand_ids'}" />
            </xpath>
        </field>
    </record>

</odoo>
