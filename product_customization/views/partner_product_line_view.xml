<odoo>
    <record model="ir.ui.view" id="product_customization_partner_product_line_form_view">
      <field name="name">product.customization.partner.product.line.form.view</field>
      <field name="model">partner.product.line</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
                <div class="oe_button_box" name="button_box"/>
                <field name="product_image" widget="image" class="oe_avatar"/>
                <div class="oe_title mb24">
                    <h1>
                        <field id="name" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="Product Name" />
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="partner_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="brand_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="product_id" required="name" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
            </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="product_customization_partner_product_line_list_view">
      <field name="name">product.customization.partner.product.line.list.view</field>
      <field name="model">partner.product.line</field>
      <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="partner_id" optional="hide"/>
            <field name="brand_id"/>
            <field name="product_id"/>
            <field name="product_image" widget="image" options="{'size': [64, 64]}"/>
        </list>
      </field>
    </record>

    <record id="product_customization_partner_product_line_search_view" model="ir.ui.view">
        <field name="name">product.customization.partner.product.line.search.view</field>
        <field name="model">partner.product.line</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <search string="Search Partner Product">
              <field name="name" string="Product Name" />
              <field name="brand_id" string="Brand"/>
              <field name="product_id" string="Product"/>
              <field name="partner_id" string="Partner" />

              <group expand="0" string="Group By">
                <filter string="Partner" name="partner_id" domain="[]" context="{'group_by': 'partner_id'}"/>
                <filter string="Brand" name="brand_id" domain="[]" context="{'group_by': 'brand_id'}"/>
                <filter string="Product" name="product_id" domain="[]" context="{'group_by': 'product_id'}"/>
              </group>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="product_customization_partner_product_line_window_action">
      <field name="name">Partner Product Line</field>
      <field name="res_model">partner.product.line</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_partner_product_details" name="Partner Product Details" parent="contacts.res_partner_menu_config" sequence="4"/>
    <menuitem name="Partner Product Line" id="menu_partner_product_line" action="product_customization_partner_product_line_window_action" parent="menu_partner_product_details"/>


</odoo>
