<?xml version="1.0" encoding="utf-8"?>
<odoo>

   
    <record id="product_customization_product_product_tree_view_inherit_tree_view" model="ir.ui.view">
        <field name="name">product.customization.product.product.tree.view.inherit.tree.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="part_no" optional="hide"/>
                <field name="brand_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_customization_product_normal_form_view_inherit_form_view" model="ir.ui.view">
        <field name="name">product.customization.product.normal.form.view.inherit.form.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="part_no" />
                <field name="brand_id"  options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
            </xpath>
        </field>
    </record>

</odoo>
